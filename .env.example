# MongoDB connection (Atlas or local)
# Local example: mongodb://127.0.0.1:27017/fashionz
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/fashionz
MONGODB_URI=mongodb://127.0.0.1:27017/fashionz

# JWT signing secret — change to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# Backend port
PORT=3001

# Frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
